---
/**
 * A 1px vertical rail made of seeded-random solid/dashed segments, on one
 * edge of its (relatively positioned) parent so rails from adjacent sections
 * line up into one continuous line.
 */
import { railSegments } from '../lib/rails';

interface Props {
	seed: number;
	side: 'left' | 'right';
}

const { seed, side } = Astro.props;
---

<span
	class:list={[
		'pointer-events-none absolute inset-y-0 flex w-px flex-col text-hairline',
		side === 'right' ? '-right-px' : '-left-px',
	]}
	aria-hidden="true"
>
	{
		railSegments(seed).map((segment) => (
			<span
				class:list={['w-px', segment.dashed ? 'rail-dash' : 'bg-current']}
				style={`flex: ${segment.flex}`}
			/>
		))
	}
</span>
