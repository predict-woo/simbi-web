---
/**
 * Four small rotated-square markers on the corners of the nearest positioned
 * ancestor, like registration marks where lines cross on a technical drawing.
 * Hidden below the wide breakpoint, where the content-column rails they sit
 * on do not exist.
 */
---

<span class="mark tl" aria-hidden="true"></span>
<span class="mark tr" aria-hidden="true"></span>
<span class="mark bl" aria-hidden="true"></span>
<span class="mark br" aria-hidden="true"></span>

<style>
	.mark {
		display: none;
		position: absolute;
		z-index: 2;
		width: 5px;
		height: 5px;
		border: 1px solid var(--hairline);
		background: var(--paper);
		transform: rotate(45deg);
	}
	@media (min-width: 1180px) {
		.mark {
			display: block;
		}
	}
	.tl { top: -4px; left: -4px; }
	.tr { top: -4px; right: -4px; }
	.bl { bottom: -4px; left: -4px; }
	.br { bottom: -4px; right: -4px; }
</style>
