---
/**
 * Diamond marks on the four corners of the content column, where its rails
 * cross the section rules. Hidden below xl, where those rails do not exist.
 *
 * The rails run 1px inside the content's inline edges and the rules 1px
 * outside its block edges, so each crossing pixel sits just outside the
 * corner in the block direction; -mb-px steps onto it.
 */
import Mark from './Mark.astro';

const corners = [
	'top-0 left-0 -mt-px',
	'top-0 right-0 -mt-px',
	'bottom-0 left-0 -mb-px',
	'bottom-0 right-0 -mb-px',
];
---

{corners.map((corner) => <Mark class:list={['hidden xl:block', corner]} />)}
