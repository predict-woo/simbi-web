---
/**
 * Diagonal hatching filling the nearest positioned ancestor: the drafting
 * convention for void space. Instances share a pattern id; the definitions
 * are identical, so first-match resolution is harmless.
 */
---

<svg class="pointer-events-none absolute inset-0 size-full text-hairline" aria-hidden="true">
	<defs>
		<pattern
			id="hatch-lines"
			width="5"
			height="5"
			patternUnits="userSpaceOnUse"
			patternTransform="rotate(45)"
		>
			<line x1="0" y1="0" x2="0" y2="5" stroke="currentColor" stroke-width="1"></line>
		</pattern>
	</defs>
	<rect width="100%" height="100%" fill="url(#hatch-lines)"></rect>
</svg>
