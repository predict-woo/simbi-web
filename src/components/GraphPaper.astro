---
/**
 * Faint accent-tinted graph paper filling the nearest positioned ancestor,
 * faded out toward the top. Pure scenery: it should be felt, not seen.
 */
---

<svg class="graph-paper" aria-hidden="true">
	<defs>
		<pattern id="graph-grid" width="12" height="12" patternUnits="userSpaceOnUse" x="-1" y="-1">
			<path d="M.5 12V.5H12" fill="none" stroke="currentColor"></path>
		</pattern>
	</defs>
	<rect width="100%" height="100%" fill="url(#graph-grid)"></rect>
</svg>

<style>
	.graph-paper {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		color: var(--accent-bright);
		opacity: 0.09;
		pointer-events: none;
		mask-image: linear-gradient(to top, rgb(255 255 255 / 70%), transparent);
	}
	@media (prefers-color-scheme: dark) {
		.graph-paper {
			opacity: 0.07;
		}
	}
</style>
