---
interface Props {
	name: 'chat' | 'copy' | 'fixer' | 'pipeline' | 'refresh';
	label: string;
}

const { name, label } = Astro.props;
---

<!--
Lucide icons v1.32.0, Copyright (c) 2026 Lucide Icons and Contributors.
ISC permission notice: https://lucide.dev/license
-->
<span class="app-icon" data-name={name} role="img" aria-label={label}>
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		{name === 'fixer' && (
			<>
				<path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z" />
				<path d="M20 2v4" />
				<path d="M22 4h-4" />
				<circle cx="4" cy="20" r="2" />
			</>
		)}
		{name === 'pipeline' && (
			<path d="M2 13a2 2 0 0 0 2-2V7a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0V4a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0v-4a2 2 0 0 1 2-2" />
		)}
		{name === 'copy' && (
			<>
				<rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
				<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
			</>
		)}
		{name === 'chat' && (
			<>
				<path d="M16 10a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 14.286V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
				<path d="M20 9a2 2 0 0 1 2 2v10.286a.71.71 0 0 1-1.212.502l-2.202-2.202A2 2 0 0 0 17.172 19H10a2 2 0 0 1-2-2v-1" />
			</>
		)}
		{name === 'refresh' && (
			<>
				<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
				<path d="M21 3v5h-5" />
				<path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
				<path d="M8 16H3v5" />
			</>
		)}
	</svg>
</span>

<style>
	.app-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.2em;
		height: 1.2em;
		margin-inline: 0.08em;
		vertical-align: -0.2em;
	}

	.app-icon[data-name='fixer'] {
		color: var(--sl-color-accent-high);
	}

	.app-icon:not([data-name='fixer']) {
		color: var(--sl-color-gray-2);
	}

	svg {
		width: 100%;
		height: 100%;
	}
</style>
