---
/**
 * The drafting frame every landing section sits in: a five-column flex row
 * of gutter / spacer / content / spacer / gutter, where the gutters and
 * spacers carry vertical rails on their content-facing edges. On narrow
 * viewports only the gutters exist (two rails); from the wide breakpoint the
 * spacers appear and the content column gets its own pair of rails.
 */
import CornerMarks from './CornerMarks.astro';
import Rail from './Rail.astro';

interface Props {
	/** Base seed for this section's four rails; vary it so no two sections share a rhythm. */
	seed: number;
	/** Render corner marks on the content column. */
	marks?: boolean;
	class?: string;
}

const { seed, marks = false, class: className } = Astro.props;
---

<section class:list={['frame', className]}>
	<span class="gutter"><Rail seed={seed} side="right" /></span>
	<span class="spacer"><Rail seed={seed + 1} side="right" /></span>
	<div class="content">
		{marks && <CornerMarks />}
		<slot />
	</div>
	<span class="spacer"><Rail seed={seed + 2} side="left" /></span>
	<span class="gutter"><Rail seed={seed + 3} side="left" /></span>
</section>

<style>
	.frame {
		position: relative;
		display: flex;
		min-width: 0;
	}
	.gutter {
		position: relative;
		flex-shrink: 0;
		width: 1rem;
	}
	@media (min-width: 640px) {
		.gutter {
			width: 1.5rem;
		}
	}
	@media (min-width: 900px) {
		.gutter {
			width: 3rem;
		}
	}
	.spacer {
		position: relative;
		display: none;
	}
	@media (min-width: 1180px) {
		.spacer {
			display: block;
			flex: 1 1 0;
		}
	}
	.content {
		position: relative;
		flex: 1 1 var(--content-max-width);
		min-width: 0;
		max-width: var(--content-max-width);
		margin-inline: auto;
	}
</style>
