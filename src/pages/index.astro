---
// Landing page, served at the site root, separate from the Starlight docs.
import { Picture } from 'astro:assets';
import appWindow from '../assets/app-window.png';
import simbiIcon from '../assets/simbi-icon.svg';
import Button from '../components/Button.astro';
import CellRow from '../components/CellRow.astro';
import Frame from '../components/Frame.astro';
import GraphPaper from '../components/GraphPaper.astro';
import DividerMarks from '../components/DividerMarks.astro';
import Hatch from '../components/Hatch.astro';
import Mark from '../components/Mark.astro';
import '../styles/global.css';

const releasesUrl = 'https://github.com/predict-woo/simbi/releases/latest';
const githubUrl = 'https://github.com/predict-woo/simbi';
const description =
	'Simbi is an open-source macOS notetaking app that records your meetings, ' +
	'transcribes them live with speaker labels, and keeps everything as plain files, ' +
	'living symbiotically with the ChatGPT plan you already have.';

const engine = [
	{
		title: 'Local diarization',
		body:
			'A compact speaker-separation model runs on the Apple Neural Engine and works out ' +
			'who is talking in about a second, without sending audio anywhere.',
	},
	{
		title: 'ChatGPT speech-to-text',
		body:
			'Speech is cut into clean per-speaker segments and transcribed by the same backend ' +
			'that powers dictation in the ChatGPT app. Far more accurate than local models, and ' +
			'easy on your battery.',
	},
	{
		title: 'Codex intelligence',
		body:
			'Transcript fixing, file conversion, summaries, and chat are Codex threads in the ' +
			'ChatGPT desktop app. Your plan, your models, your context.',
	},
];

const features = [
	{
		title: 'Live transcript fixer',
		body:
			'A Codex thread watches the transcript as it grows, fixes mis-hearings using your ' +
			'files as context, and names speakers when the conversation reveals who they are.',
	},
	{
		title: 'AI notes with citations',
		body:
			'After each recording Simbi writes a summary whose citations are timestamps. Click ' +
			'one and playback jumps to that moment in the audio.',
	},
	{
		title: 'File import',
		body:
			'Drop a PDF or a slide deck onto a note. Codex converts it to clean Markdown that ' +
			'becomes context for transcript fixes and chat.',
	},
	{
		title: 'Chat with your notes',
		body: 'One click opens a Codex chat with your note, transcript, and files already in context.',
	},
	{
		title: 'System audio capture',
		body:
			'Record your mic and the other side of the call together: system audio is captured ' +
			'and mixed into one timeline.',
	},
	{
		title: 'Crash-safe recording',
		body:
			'Audio streams straight to disk in a crash-tolerant format. If your Mac dies ' +
			'mid-meeting, the recording survives.',
	},
];

const tree = [
	['note.md', 'your notes, plain Markdown'],
	['audio.webm', 'the recording, Opus'],
	['transcript.vtt', 'transcript with speaker labels'],
	['files/', 'anything you drop in'],
	['context/', 'Markdown mirrors, written by Codex'],
];

const featureRows = [features.slice(0, 3), features.slice(3)];

const claimClass = 'relative flex flex-1 items-center gap-3 p-6 text-sm md:px-10';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Simbi, notetaking that listens</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link
			rel="stylesheet"
			type="text/css"
			href="https://spoqa.github.io/spoqa-han-sans/css/SpoqaHanSansNeo.css"
		/>
		<meta property="og:title" content="Simbi" />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(appWindow.src, Astro.site)} />
	</head>
	<body>
		<Frame seed={10}>
			<header class="flex items-center justify-between py-3.5">
				<a href="/" class="flex items-center gap-2 text-lg font-bold">
					<img src={simbiIcon.src} alt="" width="26" height="26" />
					<span>Simbi</span>
				</a>
				<nav class="flex items-center gap-6">
					<a href="/docs/" class="text-sm transition-colors hover:text-accent">Docs</a>
					<a href={githubUrl} class="text-sm transition-colors hover:text-accent">GitHub</a>
					<Button href={releasesUrl} variant="primary" class="px-4 py-1.5">Download</Button>
				</nav>
			</header>
		</Frame>

		<hr class="border-hairline" />

		<Frame seed={20} marks flush>
			<div class="relative flex flex-col items-center px-5 pt-10 text-center sm:px-8 md:pt-16 lg:px-10">
				<GraphPaper fade />
				<img
					src={simbiIcon.src}
					alt=""
					width="96"
					height="96"
					class="w-16 drop-shadow-xl md:w-20"
				/>
				<h1 class="mt-5 text-4xl font-bold tracking-tight md:text-6xl">
					Notetaking that listens.
				</h1>
				<p class="mt-4 max-w-xl md:text-lg">
					Live, speaker-labelled meeting transcripts, saved as plain files.
					<br />
					Simbi lives symbiotically with the ChatGPT plan you already have.
				</p>
				<div class="mt-6 flex flex-wrap justify-center gap-3">
					<Button href={releasesUrl} variant="primary">Download for macOS</Button>
					<Button href="/docs/">Read the docs</Button>
				</div>
				<figure class="relative z-10 my-8 w-full max-w-5xl md:my-10">
					<Picture
						src={appWindow}
						alt="The Simbi app: a note with AI summary, timestamped citations, and a live speaker-labelled transcript beside the recording"
						formats={['avif', 'webp']}
						widths={[720, 1088, 1600, appWindow.width]}
						sizes="(max-width: 1280px) calc(100vw - 2rem), 1152px"
						loading="eager"
					/>
				</figure>
			</div>
		</Frame>

		<hr class="border-hairline" />

		<Frame seed={30} marks>
			<section class="py-10 md:py-16">
				<h2 class="text-3xl font-bold tracking-tight md:text-4xl">
					Your ChatGPT subscription does the heavy lifting.
				</h2>
				<p class="mt-4 max-w-2xl">
					Even a free ChatGPT account includes dictation-grade speech-to-text and a generous
					amount of model usage. Simbi combines them with a small speaker model that runs
					entirely on your Mac.
				</p>
			</section>
		</Frame>

		<hr class="border-hairline" />

		<Frame seed={34} marks flush>
			<CellRow items={engine} />
		</Frame>

		<hr class="border-hairline" />

		<Frame seed={40} marks>
			<section class="py-10 md:py-16">
				<h2 class="text-3xl font-bold tracking-tight md:text-4xl">Every note is just a folder.</h2>
				<p class="mt-4 max-w-2xl">
					No database, no proprietary format, zero walls. If you can see it in Finder, it is
					yours.
				</p>
			</section>
		</Frame>

		<hr class="border-hairline" />

		<Frame seed={44} marks flush>
			<div class="grid md:grid-cols-5">
				<div class="relative p-6 md:col-span-3 md:p-12">
					<Hatch />
					<pre
						class="relative overflow-x-auto rounded-md border border-accent-bright/40 bg-paper p-6 font-mono text-sm leading-loose"><code>~/Simbi/Work/2026-07-15 Standup/
{tree.map(([name, note], i) => `${i === tree.length - 1 ? '└─' : '├─'} ${name.padEnd(17)}${note}\n`)}</code></pre>
				</div>
				<ul
					class="relative flex flex-col border-t border-hairline md:col-span-2 md:border-t-0 md:border-l"
				>
					<DividerMarks />
					<li class={claimClass}>
						<span>
							Open your Simbi home folder in Obsidian and your notes read perfectly: they are
							ordinary Markdown.
						</span>
					</li>
					<li class:list={[claimClass, 'border-t border-hairline']}>
						<Mark class="top-0 left-0 hidden -mt-px -ml-px md:block" />
						<Mark class="top-0 right-0 hidden -mt-px md:block" />
						<span>
							Drop <code class="font-mono text-xs">audio.webm</code> and{' '}
							<code class="font-mono text-xs">transcript.vtt</code> into VLC and the recording
							plays with speaker-labelled subtitles in sync.
						</span>
					</li>
					<li class:list={[claimClass, 'border-t border-hairline']}>
						<Mark class="top-0 left-0 hidden -mt-px -ml-px md:block" />
						<Mark class="top-0 right-0 hidden -mt-px md:block" />
						<span>
							Sync it with git or iCloud, grep it, back it up: anything that works on files
							works on Simbi.
						</span>
					</li>
				</ul>
			</div>
		</Frame>

		<hr class="border-hairline" />

		<Frame seed={50} marks>
			<section class="py-10 md:py-16">
				<h2 class="text-3xl font-bold tracking-tight md:text-4xl">Small app, sharp tools.</h2>
			</section>
		</Frame>

		{
			featureRows.map((row, rowIndex) => (
				<>
					<hr class="border-hairline" />
					<Frame seed={54 + rowIndex * 4} marks flush>
						<CellRow items={row} />
					</Frame>
				</>
			))
		}

		<hr class="border-hairline" />

		<Frame seed={60} flush>
			<div class="relative h-10" aria-hidden="true"><Hatch /></div>
		</Frame>

		<hr class="border-hairline" />

		<Frame seed={70} marks>
			<section class="flex flex-col items-center py-16 text-center md:py-24">
				<h2 class="text-3xl font-bold tracking-tight md:text-4xl">
					Zero walls around your notes.
				</h2>
				<div class="mt-8 flex flex-wrap justify-center gap-3">
					<Button href={releasesUrl} variant="primary">Download for macOS</Button>
					<Button href={githubUrl}>View on GitHub</Button>
				</div>
			</section>
		</Frame>

		<hr class="border-hairline" />

		<Frame seed={80}>
			<footer class="flex flex-wrap items-center justify-between gap-3 py-6 text-sm">
				<span>MIT licensed · © 2026 Andrew Sangwoo Ye</span>
				<nav class="flex gap-6">
					<a href="/docs/" class="transition-colors hover:text-accent">Docs</a>
					<a href={githubUrl} class="transition-colors hover:text-accent">GitHub</a>
					<a href={releasesUrl} class="transition-colors hover:text-accent">Releases</a>
				</nav>
			</footer>
		</Frame>
	</body>
</html>
